<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Admin Login</title>
  <link rel="stylesheet" href="/admin.css" />
</head>
<body class="page page-auth">
  <main class="auth-shell">
    <section class="auth-card" aria-labelledby="login-title">
      <div class="auth-header">
        <p class="pill">Admin Access</p>
        <h1 id="login-title">Welcome Back</h1>
        <p class="muted">Gunakan akun admin untuk masuk ke dashboard.</p>
      </div>

      <% if (error) { %>
        <div class="alert" role="alert">
          <span><%= error %></span>
        </div>
      <% } %>

      <form class="auth-form" method="post" action="/login">
        <label class="field">
          <span>Username / Email</span>
          <input type="text" name="email" placeholder="admin" required autocomplete="username" />
        </label>

        <label class="field">
          <span>Password</span>
          <div class="password-row">
            <input id="password" type="password" name="password" placeholder="••••••••" required autocomplete="current-password" />
            <button class="toggle" type="button" id="togglePassword" aria-label="Show password">Show</button>
          </div>
        </label>

        <button class="btn btn-primary" type="submit">Login</button>
      </form>
    </section>
  </main>

  <script>
    const toggle = document.getElementById('togglePassword');
    const password = document.getElementById('password');

    if (toggle && password) {
      toggle.addEventListener('click', () => {
        const isPassword = password.type === 'password';
        password.type = isPassword ? 'text' : 'password';
        toggle.textContent = isPassword ? 'Hide' : 'Show';
        toggle.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
      });
    }
  </script>
</body>
</html>
